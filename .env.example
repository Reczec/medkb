# Copy this file to ".env" and adjust the values. ".env" is ignored by git.

# Signing key for login tokens. Use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = a random key per start (everyone is logged out on restart).
JWT_SECRET=

# Demo mode: one-click logins as admin, doctor or patient on the login page, and the example
# data is restored on start and every DEMO_RESET_HOURS hours.
# WARNING: demo mode DELETES all entries and the change log on every start. Only for demos.
DEMO_MODE=true
DEMO_RESET_HOURS=24

# Optional: a real login "admin" with this password (works with and without demo mode).
# ADMIN_PASSWORD=

# Local default: SQLite file. Use PostgreSQL for a production-like setup, e.g.
# DATABASE_URL=postgresql+psycopg://medkb:medkb@localhost:5432/medkb
DATABASE_URL=sqlite:///./medkb.db

# Directory for JSON archive files.
ARCHIVE_DIR=archives

# Without demo mode: insert the bundled example entries on startup if the database is empty.
SEED_DEMO_DATA=true

# External sources (doctor and admin views). Answers are cached for SOURCE_CACHE_HOURS.
# PubMed and openFDA work without keys. An NCBI key only raises PubMed's rate limit:
#   https://www.ncbi.nlm.nih.gov/account/  ->  Account settings  ->  API Key Management
# NCBI_API_KEY=
# WHO ICD-11 needs free API keys, otherwise the ICD-11 tab says "nicht eingerichtet":
#   1. Register at https://icd.who.int/icdapi  ("Register")
#   2. Log in, open "View API access key(s)", copy ClientId and ClientSecret here.
# ICD_CLIENT_ID=
# ICD_CLIENT_SECRET=
# ICD_RELEASE=2026-01
# German ("de") is a WHO prerelease in 2026-01; "en" is the stable language.
# ICD_LANGUAGE=de
# SOURCES_TIMEOUT=8
# SOURCE_CACHE_HOURS=24

# AI assistance: empty key = disabled (HTTP503), no fabricated offline answers.
# Google OpenAI-compatible endpoint; choose another compatible provider/model if needed.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_DAILY_LIMIT=500
AI_CLIENT_DAILY_LIMIT=30
# Behind a reverse proxy (e.g. Render): header with the visitor's IP for the per-visitor limit.
# Only set it when the proxy overwrites that header. Empty = the connection's address.
# CLIENT_IP_HEADER=True-Client-IP
AI_TIMEOUT=30

# Semantic retrieval: enable only after index build and real evaluation (README).
RAG_ENABLED=false
# Optional separate Gemini key; otherwise AI_API_KEY reused only for Google's endpoint.
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT=15
RAG_MIN_SIMILARITY=0.60
RAG_MAX_CHUNKS=5000

# Only used by docker-compose for the bundled PostgreSQL container.
# POSTGRES_PASSWORD=medkb
