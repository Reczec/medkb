# Copy this file to ".env" and adjust the values. ".env" is ignored by git.

# Token for the admin area (archives, change log). Choose a long random value.
# Without it the admin endpoints answer with 503.
ADMIN_TOKEN=change-me

# Local default: SQLite file. Use PostgreSQL for a production-like setup, e.g.
# DATABASE_URL=postgresql+psycopg://medkb:medkb@localhost:5432/medkb
DATABASE_URL=sqlite:///./medkb.db

# Directory for JSON archive files.
ARCHIVE_DIR=archives

# Insert the bundled example entries on startup if the database is empty.
SEED_DEMO_DATA=true

# Only used by docker-compose for the bundled PostgreSQL container.
# POSTGRES_PASSWORD=medkb
