# Copy this file to ".env" and adjust the values. ".env" is ignored by git.

# Signing key for login tokens. Use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = a random key per start (everyone is logged out on restart).
JWT_SECRET=

# Demo mode: one-click logins as admin, doctor or patient on the login page, and the example
# data is restored on start and every DEMO_RESET_HOURS hours.
DEMO_MODE=true
DEMO_RESET_HOURS=24

# Optional: a real login "admin" with this password (works with and without demo mode).
# ADMIN_PASSWORD=

# Local default: SQLite file. Use PostgreSQL for a production-like setup, e.g.
# DATABASE_URL=postgresql+psycopg://medkb:medkb@localhost:5432/medkb
DATABASE_URL=sqlite:///./medkb.db

# Directory for JSON archive files.
ARCHIVE_DIR=archives

# Without demo mode: insert the bundled example entries on startup if the database is empty.
SEED_DEMO_DATA=true

# Only used by docker-compose for the bundled PostgreSQL container.
# POSTGRES_PASSWORD=medkb
